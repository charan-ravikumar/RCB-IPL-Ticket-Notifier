# Copy this file to .env and fill in your own values. Never commit .env.

# ── What to watch ───────────────────────────────────────────────────────────
# Name used in alert messages
MATCH_NAME="RCB vs CSK (Apr 5)"
# Page text that means tickets are live. Separate entries with |  (case-insensitive)
TRIGGER_TEXTS="SUN, APR 5|APRIL 5, 2026|CHENNAI SUPER KINGS"
# Page text that means the page loaded properly
HEALTH_CHECKS="BUY TICKETS|TICKETS NOT AVAILABLE"
# TICKET_URL=https://shop.royalchallengers.com/ticket

# ── Recipient 1 ─────────────────────────────────────────────────────────────
RECIPIENT_1_PHONE=+91XXXXXXXXXX
RECIPIENT_1_ACCOUNT_SID=your_twilio_account_sid
RECIPIENT_1_AUTH_TOKEN=your_twilio_auth_token
RECIPIENT_1_SMS_FROM=+1XXXXXXXXXX

# WhatsApp (optional: leave WA_CONTENT_SID unset for SMS only)
# RECIPIENT_1_WA_CONTENT_SID=your_content_template_sid
# RECIPIENT_1_WA_FROM=+14155238886
# Only if WhatsApp uses a different Twilio account:
# RECIPIENT_1_WA_ACCOUNT_SID=
# RECIPIENT_1_WA_AUTH_TOKEN=

# ── More recipients: repeat the block as RECIPIENT_2_*, RECIPIENT_3_*, ... ──
